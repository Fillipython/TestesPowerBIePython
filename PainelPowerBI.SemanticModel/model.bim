        "lineageTag": "4b5ecca9-e221-4276-8127-72022fe97112",
        "measures": [
          {
            "name": "Temperatura Media",
            "expression": "AVERAGE(fato_inmet_horaria[Temperatura_Ar])",
            "formatString": "0.00 \"°C\"",
            "lineageTag": "074ddd25-b129-40bc-be38-462109526f6b"
          },
          {
            "name": "Sensacao Termica Media",
            "expression": "AVERAGE(fato_inmet_horaria[Sensacao_Termica])",
            "formatString": "0.00 \"°C\"",
            "lineageTag": "5a295028-e58e-404a-9430-f78ce04c5d49"
          },
          {
            "name": "Temperatura Maxima",
            "expression": "MAX(fato_inmet_horaria[Temp_Maxima_Hora])",
            "formatString": "0.00 \"°C\"",
            "lineageTag": "c4947d95-67e8-45d5-8388-7b5617d844e5"
          },
          {
            "name": "Temperatura Minima",
            "expression": "MIN(fato_inmet_horaria[Temp_Minima_Hora])",
            "formatString": "0.00 \"°C\"",
            "lineageTag": "86072c74-d99a-455b-92a4-c556073ba4ca"
          },
          {
            "name": "Amplitude Termica",
            "expression": "MAX(fato_inmet_horaria[Temp_Maxima_Hora]) - MIN(fato_inmet_horaria[Temp_Minima_Hora])",
            "formatString": "0.00 \"°C\"",
            "lineageTag": "f9ab26a6-e8ef-4cdd-a844-9d40caee2e5f"
          },
          {
            "name": "Umidade Media",
            "expression": "AVERAGE(fato_inmet_horaria[Umidade_Relativa])",
            "formatString": "0.0 \"%\"",
            "lineageTag": "1aef00d9-b07e-490e-b8f2-8010139d7cd6"
          },
          {
            "name": "Chuva Acumulada (mm)",
            "expression": "SUM(fato_inmet_horaria[Precipitacao_mm])",
            "formatString": "#,0.0 \"mm\"",
            "lineageTag": "d514d7c8-c9db-4b04-ad0d-d4419d841b5c"
          },
          {
            "name": "Pressao Media (mB)",
            "expression": "AVERAGE(fato_inmet_horaria[Pressao_Atmosferica])",
            "formatString": "#,0.0 \"mB\"",
            "lineageTag": "fb02675c-cf40-424e-a980-6462a6e72c03"
          },
          {
            "name": "Horas Anomalia Termica",
            "expression": "CALCULATE(COUNTROWS(fato_inmet_horaria), fato_inmet_horaria[Anomalia_Termica] = \"Anomalia\")",
            "formatString": "#,0",
            "lineageTag": "66b104cd-9531-4f3e-9e85-11fc9e43638d"
          }
        ],
